# Notion Integration Credentials
# Get these from https://www.notion.so/my-integrations

# Your Notion integration token (starts with 'secret_')
NOTION_API_KEY=secret_your_integration_token_here

# Your Notion database ID (found in the database URL)
NOTION_DATABASE_ID=your_database_id_here

# Optional: Cache refresh interval in hours (default: 1)
CACHE_REFRESH_HOURS=1